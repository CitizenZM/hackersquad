generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  DRAFT
  RESEARCHING
  ANALYZED
  GENERATING
  COMPLETE
  ERROR
}

enum DataSource {
  OFFICIAL_API
  PUBLIC_WEB
  USER_INPUT
  AI_INFERRED
}

enum ContentType {
  YOUTUBE_VIDEO
  YOUTUBE_SHORT
  TIKTOK_VIDEO
  VIMEO_VIDEO
  WEBSITE_PAGE
  SOCIAL_POST
  WEB_MENTION
  REVIEW
}

enum NarrativeType {
  PROBLEM_SOLUTION
  TESTIMONIAL
  DEMONSTRATION
  LIFESTYLE
  EDUCATIONAL
  COMPARISON
  STORY_ARC
  UGC_STYLE
  TREND_RIDING
  BEFORE_AFTER
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brands      BrandProfile[]
  competitors CompetitorProfile[]
  projects    Project[]
}

model BrandProfile {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name             String
  url              String?
  category         String?
  brandPromise     String?
  valueProposition String?
  toneOfVoice      String?
  targetAudience   String?
  pricingTheme     String?
  productFeatures  Json?
  ctaLanguage      Json?
  socialProof      Json?

  lastCrawledAt DateTime?
  rawCrawlData  Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects Project[]
  brands   Brand[]

  @@unique([workspaceId, name])
  @@index([workspaceId, lastCrawledAt])
}

model CompetitorProfile {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name             String
  url              String?
  brandPromise     String?
  valueProposition String?
  toneOfVoice      String?
  pricingTheme     String?
  productFeatures  Json?
  ctaLanguage      Json?
  socialProof      Json?
  strengths        Json?
  weaknesses       Json?

  lastCrawledAt DateTime?
  rawCrawlData  Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  competitors Competitor[]

  @@unique([workspaceId, name])
  @@index([workspaceId, lastCrawledAt])
}

model CrawlCache {
  id            String   @id @default(cuid())
  cacheKey      String   @unique
  kind          String
  schemaVersion Int      @default(1)
  payload       Json
  fetchedAt     DateTime @default(now())
  expiresAt     DateTime

  @@index([kind, expiresAt])
  @@index([expiresAt])
}

model IdempotencyKey {
  key       String   @id
  route     String
  projectId String?
  response  Json
  status    Int      @default(200)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([projectId, route])
  @@index([expiresAt])
}

model Project {
  id        String        @id @default(cuid())
  name      String
  status    ProjectStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  workspaceId    String?
  workspace      Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  brandProfileId String?
  brandProfile   BrandProfile? @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)

  brandName    String
  brandUrl     String?
  category     String?
  campaignGoal String?

  briefingText   String?
  briefingParsed String?

  brandHealthScore Float?
  opportunityScore Float?
  topSignals       Json?

  brand             Brand?
  competitors       Competitor[]
  contentAssets     ContentAsset[]
  insights          Insight[]
  narrativePatterns NarrativePattern[]
  sellingPoints     SellingPoint[]
  scripts           Script[]
  storyboards       Storyboard[]
  creativeVariants  CreativeVariant[]
  previewAssets     PreviewAsset[]
  researchJobs      ResearchJob[]
  audienceProfile   AudienceProfile?
  deepAnalysis      DeepAnalysis?
  renderJobs        RenderJob[]
  videoReferences   VideoReference[]
}

model Brand {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  brandProfileId String?
  brandProfile   BrandProfile? @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)

  name             String
  url              String?
  brandPromise     String?
  valueProposition String?
  toneOfVoice      String?
  targetAudience   String?
  pricingTheme     String?
  socialProof      Json?
  ctaLanguage      Json?
  productFeatures  Json?

  dataSource   DataSource @default(AI_INFERRED)
  rawCrawlData Json?
  createdAt    DateTime   @default(now())
}

model Competitor {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  competitorProfileId String?
  competitorProfile   CompetitorProfile? @relation(fields: [competitorProfileId], references: [id], onDelete: SetNull)

  name             String
  url              String?
  brandPromise     String?
  valueProposition String?
  toneOfVoice      String?
  pricingTheme     String?
  productFeatures  Json?
  ctaLanguage      Json?
  socialProof      Json?
  strengths        Json?
  weaknesses       Json?

  contentAssets ContentAsset[]

  dataSource   DataSource @default(AI_INFERRED)
  rawCrawlData Json?
  createdAt    DateTime   @default(now())
}

model ContentAsset {
  id           String      @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  competitorId String?
  competitor   Competitor? @relation(fields: [competitorId], references: [id], onDelete: SetNull)

  type         ContentType
  title        String
  url          String
  thumbnailUrl String?
  description  String?
  publishedAt  DateTime?
  platform     String?

  viewCount      Int?
  likeCount      Int?
  commentCount   Int?
  engagementRate Float?
  metricsSource  DataSource @default(AI_INFERRED)

  overallScore      Float?
  hookStrength      Float?
  productVisibility Float?
  storytellingArc   Float?
  ctaQuality        Float?
  emotionalAppeal   Float?
  pacing            Float?

  hookText        String?
  narrativeType   NarrativeType?
  contentCategory String?
  keyMessages     Json?
  transcript      String?

  isBrandOwned    Boolean @default(false)
  isPaidMedia     Boolean @default(false)
  adSpendEstimate Json?

  dataSource DataSource @default(OFFICIAL_API)
  rawData    Json?
  createdAt  DateTime   @default(now())

  insights Insight[]

  @@unique([projectId, url])
  @@index([projectId, type])
  @@index([projectId, overallScore])
  @@index([projectId, isPaidMedia])
}

model Insight {
  id             String        @id @default(cuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contentAssetId String?
  contentAsset   ContentAsset? @relation(fields: [contentAssetId], references: [id], onDelete: SetNull)

  category       String
  title          String
  description    String
  importance     Float?
  evidence       Json?
  recommendation String?

  dataSource DataSource @default(AI_INFERRED)
  createdAt  DateTime   @default(now())

  @@index([projectId, category])
}

model NarrativePattern {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type           NarrativeType
  name           String
  description    String
  frequency      Int           @default(0)
  avgPerformance Float?
  examples       Json?
  bestPractices  Json?

  createdAt DateTime @default(now())

  @@unique([projectId, type])
}

model SellingPoint {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  point           String
  category        String
  strength        Float?
  frequency       Int     @default(0)
  competitorUsage Boolean @default(false)
  uniqueness      Float?

  createdAt DateTime @default(now())

  @@index([projectId, category])
}

model Script {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title          String
  angle          String
  format         String
  duration       String
  hookVariants   Json
  body           String
  ctaVariants    Json
  narrativeType  NarrativeType?
  targetEmotion  String?
  predictedScore Float?

  createdAt DateTime @default(now())
}

model Storyboard {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scriptId  String?

  title         String
  frames        Json
  totalDuration String?
  style         String?

  createdAt DateTime @default(now())
}

model CreativeVariant {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  hookVariant    String
  narrativeType  NarrativeType
  ctaVariant     String
  format         String
  predictedScore Float?
  rationale      String?
  scriptOutline  String?

  createdAt DateTime @default(now())

  @@index([projectId, predictedScore])
}

model PreviewAsset {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  prompt     String
  imageUrl   String?
  style      String?
  dimensions String?
  status     String  @default("pending")

  createdAt DateTime @default(now())
}

model RenderJob {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  kind        String // "import" | "shortsify" | "generate"
  status      String    @default("pending") // pending|running|complete|error
  progress    Float     @default(0)
  currentStep String?
  input       Json
  output      Json?
  error       String?
  outputPath  String?
  durationMs  Int?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([projectId, status])
  @@index([projectId, createdAt])
}

model VideoReference {
  id             String  @id @default(cuid())
  projectId      String
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contentAssetId String? @unique

  sourceUrl   String
  platform    String // tiktok | youtube | douyin | other
  localPath   String?
  durationSec Float?
  width       Int?
  height      Int?
  transcript  String?
  language    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([projectId, platform])
}

model ResearchJob {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status      String    @default("pending")
  progress    Float     @default(0)
  currentStep String?
  steps       Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([projectId, status])
}

model DeepAnalysis {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  videoStructure   Json?
  vibeAnalysis     Json?
  ctaAnalysis      Json?
  sellingPointDeep Json?
  competitiveGaps  Json?
  recommendations  Json?

  dataSource DataSource @default(AI_INFERRED)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model AudienceProfile {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  segments       Json?
  psychographics Json?
  painPoints     Json?
  interests      Json?
  platforms      Json?
  buyingBehavior String?
  incomeLevel    String?
  geoMarkets     Json?

  dataSource DataSource @default(AI_INFERRED)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}
