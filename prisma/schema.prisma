generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────
// Enums
// ──────────────────────────────────────────

enum PlanType {
  FREE
  BASIC
  PREMIUM
}

enum AgeGroup {
  AGE_3_4
  AGE_5_6
  AGE_7_9
}

enum LearningMode {
  LISTEN
  READ_ALONG
  INTERACTIVE
}

enum SourceType {
  TEXT_PASTE
  PDF_UPLOAD
  DOC_UPLOAD
  TXT_UPLOAD
}

enum StoryGoal {
  ENTERTAIN
  EDUCATE
  MORAL_LESSON
  VOCABULARY
  BEDTIME
}

enum NarrationMode {
  DEFAULT_TTS
  PARENT_VOICE
}

enum VisualStyle {
  CARTOON
  WATERCOLOR
  STORYBOOK
  PIXEL_ART
}

enum StoryPackStatus {
  DRAFT
  PROCESSING
  REVIEW_READY
  APPROVED
  PUBLISHED
  ERROR
}

enum VoiceProfileStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum PipelineJobStatus {
  PENDING
  RUNNING
  COMPLETE
  ERROR
}

enum SessionEventType {
  PLAY_START
  PLAY_PAUSE
  PLAY_RESUME
  PLAY_COMPLETE
  EPISODE_START
  EPISODE_COMPLETE
  FLASHCARD_VIEW
  VOCABULARY_TAP
}

// ──────────────────────────────────────────
// Models
// ──────────────────────────────────────────

model ParentAccount {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  planType     PlanType @default(FREE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  children       ChildProfile[]
  storySources   StorySource[]
  voiceProfiles  VoiceProfile[]
  avatarProfiles AvatarProfile[]
  storyPacks     StoryPack[]
}

model ChildProfile {
  id           String       @id @default(cuid())
  parentId     String
  parent       ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
  name         String
  age          Int
  ageGroup     AgeGroup
  language     String       @default("en")
  interests    Json         @default("[]")
  learningMode LearningMode @default(LISTEN)
  avatarUrl    String?
  pin          String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  storyPacks    StoryPack[]
  sessionEvents SessionEvent[]

  @@index([parentId])
}

model StorySource {
  id         String     @id @default(cuid())
  parentId   String
  parent     ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
  sourceType SourceType
  title      String
  rawText    String     @db.Text
  fileUrl    String?
  wordCount  Int
  language   String     @default("en")
  createdAt  DateTime   @default(now())

  storyPacks StoryPack[]

  @@index([parentId])
}

model StoryPack {
  id             String          @id @default(cuid())
  sourceId       String
  source         StorySource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  childProfileId String
  childProfile   ChildProfile    @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  parentId       String
  parent         ParentAccount   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  title          String
  storyGoal      StoryGoal       @default(ENTERTAIN)
  narrationMode  NarrationMode   @default(DEFAULT_TTS)
  visualStyle    VisualStyle     @default(CARTOON)
  status         StoryPackStatus @default(DRAFT)
  episodeCount   Int             @default(0)
  coverImageUrl  String?
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  episodes      Episode[]
  pipelineJobs  PipelineJob[]
  sessionEvents SessionEvent[]

  @@index([parentId])
  @@index([childProfileId])
  @@index([sourceId])
}

model Episode {
  id             String   @id @default(cuid())
  storyPackId    String
  storyPack      StoryPack @relation(fields: [storyPackId], references: [id], onDelete: Cascade)
  episodeNumber  Int
  title          String
  scriptText     String   @db.Text
  sourceExcerpt  String?  @db.Text
  wordBudget     Int
  durationTarget Int
  audioUrl       String?
  createdAt      DateTime @default(now())

  flashcardScenes FlashcardScene[]
  vocabularyCards VocabularyCard[]
  sessionEvents   SessionEvent[]

  @@unique([storyPackId, episodeNumber])
  @@index([storyPackId])
}

model FlashcardScene {
  id          String  @id @default(cuid())
  episodeId   String
  episode     Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  sceneOrder  Int
  prompt      String
  imageUrl    String?
  textSnippet String
  duration    Int?
  createdAt   DateTime @default(now())

  @@unique([episodeId, sceneOrder])
  @@index([episodeId])
}

model VocabularyCard {
  id         String  @id @default(cuid())
  episodeId  String
  episode    Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  word       String
  definition String
  example    String?
  imageUrl   String?
  createdAt  DateTime @default(now())

  @@index([episodeId])
}

model VoiceProfile {
  id             String             @id @default(cuid())
  parentId       String
  parent         ParentAccount      @relation(fields: [parentId], references: [id], onDelete: Cascade)
  voiceType      String             @default("default")
  sampleAudioUrl String?
  status         VoiceProfileStatus @default(PENDING)
  createdAt      DateTime           @default(now())

  @@index([parentId])
}

model AvatarProfile {
  id           String @id @default(cuid())
  parentId     String
  parent       ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
  imageUrl     String?
  cartoonStyle String @default("friendly")
  assignedName String?
  createdAt    DateTime @default(now())

  @@index([parentId])
}

model PipelineJob {
  id           String            @id @default(cuid())
  storyPackId  String
  storyPack    StoryPack         @relation(fields: [storyPackId], references: [id], onDelete: Cascade)
  status       PipelineJobStatus @default(PENDING)
  progress     Float             @default(0)
  currentStep  String?
  steps        Json?
  error        String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime          @default(now())

  @@index([storyPackId, status])
}

model SessionEvent {
  id             String           @id @default(cuid())
  childProfileId String
  childProfile   ChildProfile     @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  storyPackId    String
  storyPack      StoryPack        @relation(fields: [storyPackId], references: [id], onDelete: Cascade)
  episodeId      String?
  episode        Episode?         @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  eventType      SessionEventType
  duration       Int?
  metadata       Json?
  createdAt      DateTime         @default(now())

  @@index([childProfileId])
  @@index([storyPackId])
  @@index([createdAt])
}
